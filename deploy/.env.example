# Local development env for the db + api containers (copy to .env).
# These are throwaway dev values — the real deploy generates strong secrets on
# the box in launch-script.sh. Do NOT commit a real .env (it's gitignored).
NODE_ENV=production
PORT=8080
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=dev-secret-change-me-at-least-16-chars
ADMIN_DB_PASSWORD=devpw
APP_DB_PASSWORD=devpw
DATABASE_URL=postgres://helm_app:devpw@db:5432/helm
DATABASE_ADMIN_URL=postgres://postgres:devpw@db:5432/helm
